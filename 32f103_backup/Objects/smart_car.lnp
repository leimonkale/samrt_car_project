--cpu Cortex-M3
".\objects\main.o"
".\objects\delay.o"
".\objects\motor.o"
".\objects\hcsr04.o"
".\objects\engin.o"
".\objects\uart.o"
".\objects\misc.o"
".\objects\stm32f10x_dac.o"
".\objects\stm32f10x_gpio.o"
".\objects\stm32f10x_i2c.o"
".\objects\stm32f10x_rcc.o"
".\objects\stm32f10x_tim.o"
".\objects\stm32f10x_usart.o"
".\objects\gpio_stm32f10x.o"
".\objects\startup_stm32f10x_md.o"
".\objects\system_stm32f10x.o"
--library_type=microlib --strict --scatter ".\Objects\smart_car.sct"
